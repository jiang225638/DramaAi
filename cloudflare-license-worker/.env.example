# Cloudflare Worker 环境变量配置示范
# 生产环境使用: wrangler secret put <KEY>

# Ed25519 私钥 (PKCS8 格式 PEM 或单行 Base64)
ED25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEICn9pi1YMQ78R7rejbPJ3KEugaFSkcFGyRIgSk7AvVSJ\n-----END PRIVATE KEY-----"

# 管理员接口调用密钥（用于批量制卡与售后重置）
ADMIN_SECRET="your-super-strong-admin-secret"
